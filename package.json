{
  "name": "bace-tdbsolution",
  "private": true,
  "version": "0.1.0",
  "description": "BACE-TDBSOLUTION — Multi-tenant CRM SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @bace/api",
    "dev:web": "npm run dev -w @bace/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run prisma:generate -w @bace/api",
    "db:migrate": "npm run prisma:migrate -w @bace/api",
    "db:seed": "npm run prisma:seed -w @bace/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
