# Shared / local development
NODE_ENV=development

# API
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://bace:bace_secret@localhost:5433/bace_crm?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (change in production)
JWT_ACCESS_SECRET=bace_dev_access_secret_change_me_32chars
JWT_REFRESH_SECRET=bace_dev_refresh_secret_change_me_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bace_minio
S3_SECRET_KEY=bace_minio_secret
S3_BUCKET=bace-crm
S3_FORCE_PATH_STYLE=true

# Seed admin (first tenant)
SEED_TENANT_NAME=BACE Internal
SEED_TENANT_SLUG=bace-internal
SEED_ADMIN_EMAIL=admin@bace.local
SEED_ADMIN_PASSWORD=Admin@123456
